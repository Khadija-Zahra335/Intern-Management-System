// Intern Management Platform — Prisma schema
// Revised after mentor feedback: Week and CheckIn removed,
// Attendance and TaskActivity added.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/erd.svg"
}
  
datasource db {
  provider = "postgresql"
}


enum Role {
  MENTOR
  INTERN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(INTERN)
  createdAt    DateTime @default(now())

  memberships   Membership[]
  createdTasks  Task[]         @relation("TaskAuthor")
  givenFeedback Feedback[]     @relation("FeedbackAuthor")
  activities    TaskActivity[] @relation("ActivityAuthor")
  authTokens    AuthToken[]
}

// Single-use, time-limited tokens emailed to a user — either to let them
// reset a forgotten password, or to sign in without a password at all
// ("magic link"). Only a sha256 hash of the token is ever stored; the raw
// token exists only in the emailed link, never in the database.
enum AuthTokenPurpose {
  PASSWORD_RESET
  MAGIC_LOGIN
}

model AuthToken {
  id        String           @id @default(uuid())
  userId    String
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Cohort {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  memberships Membership[]
  tasks       Task[]
}

model Membership {
  id       String   @id @default(uuid())
  userId   String
  cohortId String
  isActive Boolean  @default(true)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  cohort Cohort @relation(fields: [cohortId], references: [id])

  assignments   TaskAssignment[]
  attendance    Attendance[]
  feedback      Feedback[]
  linkedInPosts LinkedInPost[]

  @@unique([userId, cohortId])
}
 

enum TaskState {
  DRAFT
  PUBLISHED
}

model Task {
  id          String    @id @default(uuid())
  cohortId    String
  createdById String
  title       String
  description String
  state       TaskState @default(DRAFT)
  aiGenerated Boolean   @default(false)
  startDate   DateTime?
  endDate     DateTime? 
  createdAt   DateTime  @default(now())

  createdBy User @relation("TaskAuthor", fields: [createdById], references: [id])
  cohort    Cohort @relation(fields: [cohortId], references: [id])
  assignments TaskAssignment[]

  @@index([cohortId])
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  SUBMITTED // intern's ceiling — "ready for review"
  COMPLETED // mentor only
}

model TaskAssignment {
  id           String           @id @default(uuid())
  taskId       String
  membershipId String
  status       AssignmentStatus @default(NOT_STARTED)
  assignedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  task       Task       @relation(fields: [taskId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  submissions Submission[]
  activities  TaskActivity[]

  @@unique([taskId, membershipId])
  @@index([taskId])
  @@index([membershipId])
}

model TaskActivity {
  id           String   @id @default(uuid())
  assignmentId String
  authorId     String
  content      String
  links        String[]
  createdAt    DateTime @default(now())

  assignment TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User           @relation("ActivityAuthor", fields: [authorId], references: [id])

  @@index([assignmentId])
}

model Submission {
  id           String    @id @default(uuid())
  assignmentId String
  content      String?
  links        String[]
  submittedAt  DateTime  @default(now())
  reviewNote   String? // mentor's reason if sent back
  reviewedAt   DateTime?

  assignment  TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([assignmentId])
}

model Attachment {
  id           String   @id @default(uuid())
  submissionId String
  fileName     String
  fileUrl      String
  publicId     String
  fileType     String
  fileSize     Int
  uploadedAt   DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  LUNCH_START
  LUNCH_END
  AFK_START
  AFK_END
  RELAX_START
  RELAX_END
}

model Attendance {
  id           String         @id @default(uuid())
  membershipId String
  type         AttendanceType
  occurredAt   DateTime       @default(now())
  note         String?       // late-checkout reason, relax-mode reason

  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([membershipId, occurredAt])
}


model Feedback {
  id           String   @id @default(uuid())
  membershipId String
  mentorId     String
  weekNumber   Int
  rating       Int
  comment      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id])
  mentor     User       @relation("FeedbackAuthor", fields: [mentorId], references: [id])

  @@unique([membershipId, weekNumber])
  @@index([membershipId])
}

model LinkedInPost {
  id           String   @id @default(uuid())
  membershipId String
  weekNumber   Int
  url          String
  loggedAt     DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, url])
  @@index([membershipId])
  @@index([weekNumber])
  
}
