// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  MENTOR
  INTERN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(INTERN)
  createdAt    DateTime @default(now())
  

  memberships           Membership[]
  createdTasks          Task[]       @relation("TaskAuthor")
  givenFeedback         Feedback[]   @relation("FeedbackAuthor")
  
}

model Cohort {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  

  memberships Membership[]
  weeks       Week[]
}


model Membership {
  id        String   @id @default(uuid())
  userId    String
  cohortId  String
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  

  user   User   @relation(fields: [userId], references: [id])
  cohort Cohort @relation(fields: [cohortId], references: [id])

  assignments   TaskAssignment[]
  checkIns      CheckIn[]
  feedback      Feedback[]
  linkedInPosts LinkedInPost[]

  @@unique([userId, cohortId])
}

model Week {
  id         String   @id @default(uuid())
  cohortId   String
  weekNumber Int
  startDate  DateTime
  endDate    DateTime

  cohort Cohort @relation(fields: [cohortId], references: [id])

  tasks         Task[]
  checkIns      CheckIn[]
  feedback      Feedback[]
  linkedInPosts LinkedInPost[]

  @@unique([cohortId, weekNumber])
}

enum TaskState {
  DRAFT
  PUBLISHED
}

model Task {
  id          String    @id @default(uuid())
  weekId      String
  createdById String
  title       String
  description String
  state       TaskState @default(DRAFT)
  aiGenerated Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  week      Week @relation(fields: [weekId], references: [id])
  createdBy User @relation("TaskAuthor", fields: [createdById], references: [id])

  assignments TaskAssignment[]
}


enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  SUBMITTED     // intern's ceiling — "ready for review"
  COMPLETED     // mentor only
}

model TaskAssignment {
  id           String           @id @default(uuid())
  taskId       String
  membershipId String
  status       AssignmentStatus @default(NOT_STARTED)
  assignedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  task       Task       @relation(fields: [taskId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  submissions Submission[]

  @@unique([taskId, membershipId])
  @@index([membershipId])
  @@index([taskId])

}

model Submission {
  id           String    @id @default(uuid())
  assignmentId String
  content      String?
  links        String[]
  submittedAt  DateTime  @default(now())

  reviewNote   String?    // mentor's reason if sent back
  reviewedAt   DateTime?
  

  assignment  TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  
}

model Attachment {
  id           String   @id @default(uuid())
  submissionId String
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedAt   DateTime @default(now())

submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}






model CheckIn {
  id           String   @id @default(uuid())
  membershipId String
  weekId       String
  progress     String
  blockers     String?
  links        String[]
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id])
  week       Week       @relation(fields: [weekId], references: [id])
  @@unique([membershipId, weekId])
  @@index([membershipId])
  @@index([weekId])

}


model Feedback {
  id           String   @id @default(uuid())
  membershipId String
  weekId       String
  mentorId     String
  rating       Int
  comment      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id])
  week       Week       @relation(fields: [weekId], references: [id])
  mentor     User       @relation("FeedbackAuthor", fields: [mentorId], references: [id])

  @@unique([membershipId, weekId])
  @@index([membershipId])
  @@index([weekId])

}

model LinkedInPost {
  id           String   @id @default(uuid())
  membershipId String
  weekId       String
  url          String
  loggedAt     DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id])
  week       Week       @relation(fields: [weekId], references: [id])
  @@index([membershipId])
  @@index([weekId])

}
